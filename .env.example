# NetGent Configuration (Optional)
# In Antigravity Mode (Default), no external API key is required.

# Google Gemini API Key (Optional, for External AI Mode)
GEMINI_API_KEY=

# OpenAI API Key (Optional, for External AI Mode)
OPENAI_API_KEY=

# Local Ollama Host (Optional, default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Cisco Packet Tracer IPC Port (Default: 7531)
CPT_IPC_PORT=7531
